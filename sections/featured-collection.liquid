<section class="section"><div class="page-width"><div class="section-head"><div><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.title }}</h2></div>{% if section.settings.collection != blank %}<a href="{{ section.settings.collection.url }}">Tout voir →</a>{% endif %}</div><div class="grid">{% for product in section.settings.collection.products limit: section.settings.products_to_show %}{% render 'product-card', product: product %}{% else %}{% for i in (1..4) %}<article class="card"><div class="card-media">{{ 'product-' | append: i | placeholder_svg_tag }}</div><div class="card-content"><h3>Produit exemple</h3><span class="price">299,00 MAD</span></div></article>{% endfor %}{% endfor %}</div></div></section>
{% schema %}{"name":"Collection vedette","settings":[{"type":"text","id":"eyebrow","label":"Sur-titre","default":"Nos essentiels"},{"type":"text","id":"title","label":"Titre","default":"Les plus populaires"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","min":2,"max":8,"step":1,"default":4,"label":"Produits à afficher"}],"presets":[{"name":"Collection vedette"}]}{% endschema %}
