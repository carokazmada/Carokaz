<footer class="footer"><div class="page-width"><div class="footer-grid"><div class="footer-brand"><div class="logo"><span class="logo-mark">C</span><span>{{ shop.name | default: 'Carokaz' }}</span></div><p>{{ section.settings.text }}</p>{% form 'customer', class: 'newsletter' %}<input type="hidden" name="contact[tags]" value="newsletter"><input class="field" type="email" name="contact[email]" placeholder="Votre e-mail" required aria-label="Votre e-mail"><button class="button" type="submit">S’inscrire</button>{% endform %}</div><div><strong>Boutique</strong><ul>{% for link in section.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul></div><div><strong>Informations</strong><ul>{% for link in section.settings.info_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul></div></div><div class="footer-bottom">© {{ 'now' | date: '%Y' }} {{ shop.name }}. Tous droits réservés. {{ powered_by_link }}</div></div></footer>
{% schema %}{"name":"Pied de page","settings":[{"type":"textarea","id":"text","label":"Présentation","default":"Votre destination de confiance pour les pièces et accessoires automobiles au Maroc."},{"type":"link_list","id":"menu","label":"Menu boutique","default":"main-menu"},{"type":"link_list","id":"info_menu","label":"Menu informations","default":"footer"}]}{% endschema %}
