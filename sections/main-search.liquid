<section class="section"><div class="page-width"><h1>Recherche</h1><form action="{{ routes.search_url }}"><input class="field" style="max-width:600px" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Rechercher un produit"><button class="button">Rechercher</button></form>{% if search.performed %}<p>{{ search.results_count }} résultat(s)</p><div class="grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>{% endif %}</div></section>
{% schema %}{"name":"Recherche principale","settings":[]}{% endschema %}
