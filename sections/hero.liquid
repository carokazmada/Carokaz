<section class="hero"><div class="page-width hero-grid"><div><span class="eyebrow">{{ section.settings.eyebrow }}</span><h1>{{ section.settings.title }}</h1><div>{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}{% if section.settings.second_label != blank %}<a class="button button--secondary" href="{{ section.settings.second_link }}">{{ section.settings.second_label }}</a>{% endif %}</div><div class="hero-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'eager', widths: '550, 800, 1100', alt: section.settings.image.alt }}{% else %}<div class="hero-placeholder">🚗</div>{% endif %}</div></div></section>
{% schema %}{"name":"Bannière Carokaz","settings":[{"type":"text","id":"eyebrow","label":"Sur-titre","default":"L’équipement auto, simplement"},{"type":"text","id":"title","label":"Titre","default":"Roulez mieux. Équipez-vous malin."},{"type":"richtext","id":"text","label":"Texte","default":"<p>Pièces, accessoires et équipements automobiles sélectionnés pour leur fiabilité, au meilleur prix.</p>"},{"type":"text","id":"button_label","label":"Bouton principal","default":"Découvrir la boutique"},{"type":"url","id":"button_link","label":"Lien principal"},{"type":"text","id":"second_label","label":"Bouton secondaire","default":"Nos nouveautés"},{"type":"url","id":"second_link","label":"Lien secondaire"},{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"Bannière Carokaz"}]}{% endschema %}
