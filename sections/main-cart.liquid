<section class="section"><div class="page-width"><h1>Votre panier</h1>{% if cart.empty? %}<div class="empty-state"><p>Votre panier est vide.</p><a class="button" href="{{ routes.all_products_collection_url }}">Continuer mes achats</a></div>{% else %}{% form 'cart', cart %}{% for item in cart.items %}<div class="cart-row">{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.title }}<div><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a><div>{{ item.variant.title }}</div><input class="field" style="max-width:90px" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div><div>{{ item.final_line_price | money }}<br><a href="{{ item.url_to_remove }}">Supprimer</a></div></div>{% endfor %}<div class="cart-total"><strong>Total : {{ cart.total_price | money }}</strong><button class="button" name="update">Mettre à jour</button><button class="button" name="checkout">Commander</button></div>{% endform %}{% endif %}</div></section>
{% schema %}{"name":"Panier principal","settings":[]}{% endschema %}
