<section class="section"><div class="page-width"><div class="section-head"><div><span class="eyebrow">{{ collection.products_count }} produits</span><h1>{{ collection.title }}</h1></div></div>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}{% paginate collection.products by 16 %}<div class="grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<div class="empty-state">Aucun produit dans cette collection.</div>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div></section>
{% schema %}{"name":"Collection principale","settings":[]}{% endschema %}
