<article class="card">
  <a href="{{ product.url }}">
    <div class="card-media">
      {% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', alt: product.featured_image.alt | default: product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
      {% if product.compare_at_price > product.price %}<span class="badge">Promo</span>{% endif %}
    </div>
    <div class="card-content"><h3>{{ product.title }}</h3><span class="price">{{ product.price | money }}</span>{% if product.compare_at_price > product.price %}<span class="compare">{{ product.compare_at_price | money }}</span>{% endif %}</div>
  </a>
</article>
