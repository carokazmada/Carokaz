# ══════════════════════════════════════════════════════════
# CAROKAZ MADA — CONFIGURATION
# Copier ce fichier en ".env" et remplir. NE JAMAIS le committer.
# ══════════════════════════════════════════════════════════

# ---- SHOPIFY (T2 T3 T4 T5) ----
# Admin > Paramètres > Applications > Développer des apps > jeton Admin API
# Scopes requis : read_products, write_products, write_publications, read_publications
SHOPIFY_SHOP=carokazmada-store.myshopify.com
SHOPIFY_API_VERSION=2025-07
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxx

# ---- META / MESSENGER (T1) ----
# Page Access Token avec pages_messaging + pages_manage_metadata
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# ---- GOOGLE SEARCH CONSOLE (T6) ----
# Chemin vers le JSON du compte de service.
# Le compte de service doit être ajouté comme utilisateur dans GSC (droit Propriétaire).
GOOGLE_SERVICE_ACCOUNT_JSON=./gsc-service-account.json
GSC_SITE_URL=sc-domain:carokazmada.com

# ---- SITE ----
SITE_URL=https://carokazmada.com

# ---- GOLF 7 GTI (T3) ----
# Laisser vide tant que le prix n'est pas arrêté : le script refusera de publier.
# Format attendu : un nombre entier en Ariary, sans séparateurs (ex: 90000000).
GTI_PRICE=
